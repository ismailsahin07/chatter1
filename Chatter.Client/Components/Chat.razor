@page "/chat"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.SignalR.Client
@using Chatter.Core
@using Chatter.Core.Interfaces
@using Microsoft.Extensions.Logging
@inject ILogger<Chat> _logger
@inject IConfiguration config
@implements IAsyncDisposable

<PageTitle>Chat</PageTitle>

<div class="row mb-2">
    <label class="col-sm-1 col-form-label">User</label>
    <div class="col-sm-4">
        <input class="form-control" @bind="userName" @bind:event="oninput" />
    </div>
</div>

<div class="row mb-2">
    <label class="col-sm-1 col-form-label">Message</label>
    <div class="col-sm-6">
        <input class="form-control" @bind="draft" @bind:event="oninput" />
    </div>
</div>

<button class="btn btn-primary" @onclick="Send" disabled="@(!IsConnected)">Send</button>

@if (statusMessage is not null)
{
    <div class="alert alert-warning">@statusMessage</div>
}

@if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<hr>

<ul>
    @foreach (var message in _messages)
    {
        <li><b>@message.User</b> (@message.SentAt.LocalDateTime.ToShortTimeString()): @message.Payload</li>
    }
</ul>

@code {
    private HubConnection? hubConnection;
    private readonly List<MessageDto> _messages = new();
    private string userName = string.Empty;
    private string draft = string.Empty;
    private string? errorMessage;
    private string? statusMessage;

    private bool IsConnected => hubConnection?.State == HubConnectionState.Connected;

    protected override async Task OnInitializedAsync()
    {
        hubConnection = new HubConnectionBuilder()
            .WithUrl((config["HubConnectionUrl"])
                ?? throw new InvalidOperationException("HubConnectionUrl is missing from appsettings.json in the Client project"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<MessageDto>(nameof(IChatClient.ReceiveMessage), msg =>
        {
            InvokeAsync(() => { if (_messages.Exists(m => m.Id == msg.Id)) return; _messages.Add(msg); StateHasChanged(); });
        });

        hubConnection?.Closed += async ex =>
        {
            _logger.LogWarning($"Hub connection has lost: {ex?.Message}");
            errorMessage = "Connection has closed.";
            await InvokeAsync(StateHasChanged);
        };

        errorMessage = null;

        hubConnection?.Reconnecting += async ex =>
        {
            _logger.LogWarning($"Reconnecting to the hub: {ex?.Message}");
            statusMessage = "Reconnecting...";
            await InvokeAsync(StateHasChanged);
        };

        statusMessage = null;

        hubConnection?.Reconnected += async connectionId =>
        {
            _logger.LogInformation($"Reconnected to the hub with ID: {connectionId}");
            statusMessage = "Connected.";
            await LoadHistoryAsync();
            await InvokeAsync(StateHasChanged);
        };

        statusMessage = null;

        await ConnectAsync();
    }

    private async Task ConnectAsync()
    {
        errorMessage = null;

        try
        {
            await hubConnection!.StartAsync();
            await LoadHistoryAsync();
        }
        catch (Exception ex)
        {
            _logger.LogError($"Hub connection initiation failed: {ex.Message}");
            errorMessage = "Connection has failed.";
        }
    }

    private async Task Send()
    {
        if (hubConnection is null || string.IsNullOrWhiteSpace(draft)) return;
        try
        {
            await hubConnection.SendAsync("SendMessage", draft, userName);
            draft = string.Empty;
            errorMessage = null;
        }
        catch(Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadHistoryAsync()
    {
        if (hubConnection is null) return;

        List<MessageDto> messages = await hubConnection!.InvokeAsync<List<MessageDto>>("GetRecentMessages");
        await InvokeAsync(() => 
        { 
            foreach (MessageDto msg in messages)
            {
                if (_messages.Exists(m => m.Id == msg.Id))
                    continue;
                _messages.Add(msg);
                
            }
            _messages.Sort((a, b) => a.SentAt.CompareTo(b.SentAt));
            StateHasChanged();
        });
        
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
            await hubConnection.DisposeAsync();
    }
}
